# Public API base, as the BROWSER sees it. RELATIVE on purpose.
#
# This value is shipped to the browser by definition, so it has to be reachable
# from there. It used to be an absolute Docker-internal URL, which resolved for
# SSR and failed on DNS in the browser — and pages/interview/[token].vue routes
# every non-401 failure to reason=403, so a candidate was told their interview
# had expired when the request never left their laptop.
#
# `/api` is served by the Nitro proxy in server/routes/api/[...].ts on this
# app's own origin, so the browser makes no cross-origin request at all. The
# /api suffix is PART OF THE BASE — composables append paths like
# /candidate/interview/start to it.
NUXT_PUBLIC_API_BASE=/api

# Where that proxy FORWARDS. Server-side only, never shipped to the browser.
#
# REQUIRED in every deployment. Without it the proxy has no target and returns
# 500 on every API call, which on Railway looks exactly like the API being down.
# Must be NUXT_-prefixed: Nuxt maps only that prefix onto runtimeConfig, so a
# differently-named variable is read as undefined no matter what is set.
#
# Local (outside Docker): http://localhost:8000
# Docker compose:         http://api:8000   (set in docker-compose.yml)
# Railway:                the api service's internal URL
NUXT_API_ORIGIN=http://localhost:8000

# Application environment — controls noindex meta tag
# Values: local | staging | production
# - local and staging always get noindex, nofollow
# - production may serve normal robots headers for the landing page
NUXT_PUBLIC_APP_ENV=local

# Sentry — application error monitoring (C13). Left EMPTY on purpose: the SDK
# does not initialize without a DSN (app/utils/sentry-init.ts). A real value
# is a per-deployment credential and must never be committed.
NUXT_PUBLIC_SENTRY_DSN=

# Source-map upload at build/deploy time. Leave unset locally — uploads are
# skipped entirely without SENTRY_AUTH_TOKEN (nuxt.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
