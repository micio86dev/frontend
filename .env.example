# Public API base URL (points to the api service).
# The /api suffix is PART OF THE BASE — composables append paths like
# /candidate/interview/start to it. Same convention as backoffice and docker-compose.yml.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Application environment — controls noindex meta tag
# Values: local | staging | production
# - local and staging always get noindex, nofollow
# - production may serve normal robots headers for the landing page
NUXT_PUBLIC_APP_ENV=local

# Sentry — application error monitoring (C13). Left EMPTY on purpose: the SDK
# does not initialize without a DSN (app/utils/sentry-init.ts). A real value
# is a per-deployment credential and must never be committed.
NUXT_PUBLIC_SENTRY_DSN=

# Source-map upload at build/deploy time. Leave unset locally — uploads are
# skipped entirely without SENTRY_AUTH_TOKEN (nuxt.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
