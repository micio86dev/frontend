{
  "name": "frontend",
  "version": "0.9.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "test:unit": "node node_modules/.bin/vitest run",
    "test:unit:coverage": "node node_modules/.bin/vitest run --coverage",
    "test:e2e": "node node_modules/.bin/playwright test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "codegen": "bunx openapi-typescript openapi.json -o types/api.ts",
    "codegen:check": "bash scripts/check-client-drift.sh",
    "proctor:assets": "node scripts/proctor-assets.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@fontsource/open-sans": "^5.3.0",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@lucide/vue": "^1.25.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@nuxtjs/i18n": "^9.0",
    "@sentry/nuxt": "^10.70.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.8",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10",
    "@nuxt/eslint-config": "^1.16.0",
    "@playwright/test": "^1.52",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.0",
    "@vue/test-utils": "^2.4",
    "eslint": "^9.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1",
    "lint-staged": "^15.0",
    "openapi-typescript": "^7.0",
    "prettier": "^3.5",
    "tailwindcss": "^4.0",
    "typescript": "^5.8",
    "vitest": "^3.0",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.0.1",
    "tar": "^7.5.22"
  }
