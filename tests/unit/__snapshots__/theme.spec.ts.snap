// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`brand theme token source (regression guard) > :root semantic block matches the known-good snapshot 1`] = `
"--background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary: oklch(0.455 0.213 307.581); /* #771aaf — Quint purple */
  /* Was a constant near-white, which is unreadable on a light client colour
     (white on #ffd400 is 1.5:1). It follows the derived on-primary token, so a
     primary Button reads on any brand (DESIGN.md §3.1). */
  --primary-foreground: var(--color-on-primary);
  --secondary: oklch(0.97 0 0);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --accent: oklch(0.634 0.187 37.49); /* #e45526 — Quint orange */
  --accent-foreground: oklch(0.205 0 0);
  --destructive: oklch(0.577 0.245 27.325);
  --border: oklch(0.922 0 0);
  /* D12 — was oklch(0.922 0 0) (shadcn's unbranded default, ≈1.18:1-class
     failure against DESIGN.md §9's binding ≥3:1). Referenced via var(), not a
     fresh oklch literal, so this can never drift from the @theme-literal hex
     value DESIGN.md §3.1 documents as the source of truth — and because
     happy-dom's test DOM cannot parse oklch() at all (verified during RED), a
     literal oklch recomputation here would be untestable by
     tests/unit/theme.spec.ts. Mirrors backoffice/app/assets/css/main.css
     verbatim per DESIGN.md §17 cross-app parity. */
  --input: var(--color-neutral-500);
  --ring: oklch(0.708 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --radius: 0.625rem;
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: oklch(0.205 0 0);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.97 0 0);
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.922 0 0);
  --sidebar-ring: oklch(0.708 0 0);"
`;

exports[`brand theme token source (regression guard) > @theme inline bridge omits the six colliding keys (--color-primary, --color-accent, --radius-sm/md/lg/xl) 1`] = `
