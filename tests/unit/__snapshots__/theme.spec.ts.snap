exports[`brand theme token source (regression guard) > @theme literal block matches the known-good snapshot 1`] = `
"/* === Colors === */
  /* Source of truth: DESIGN.md §3.1 at wrapper root. Keep in sync. */
  /* Normative Quint brand values (D9 — C7b reconciliation; replaces stale navy/teal) */
  --color-primary: #771aaf;
  --color-primary-light: #c222d3;
  --color-primary-dark: #4f1aaf;
  --color-accent: #e45526;
  --color-accent-light: #f19823;
  --color-accent-dark: #b8431e;

  /* Supporting secondary — subtle highlights, badges (DESIGN.md §3.1) */
  --color-lavender: #8373d2;

  /* Page background gradient — supersedes flat --color-neutral-50 for page backgrounds */
  --color-bg-gradient: linear-gradient(135deg, #faf7fd 0%, #f6f1fc 45%, #fdf4ef 100%);

  --color-neutral-50: #f8fafc;
  --color-neutral-100: #f1f5f9;
  --color-neutral-200: #e2e8f0;
  --color-neutral-400: #94a3b8;
  /* D12 — form control border contrast fix (DESIGN.md §9, §3.1). #94a3b8
     (neutral-400) measured 2.6:1 and #475569 (neutral-600) 7.5:1-but-heavy;
     #64748b clears the ≥3:1 minimum at ≈4.55:1 on --color-neutral-50 while
     staying visually light. */
  --color-neutral-500: #64748b;
  --color-neutral-600: #475569;
  --color-neutral-800: #1e293b;
  --color-neutral-900: #0f172a;

  /* \`--color-success\` / \`--color-warning\` are fill-only: neither reaches 4.5:1
     as text or as an icon on a light surface. The \`-dark\` pair is the
     text-and-icon-safe variant (7.1:1 on white) mandated by DESIGN.md §9.1 and
     was missing here while present in \`backoffice\` — drift, now closed. */
  --color-success: #22c55e;
  --color-success-light: #dcfce7;
  --color-success-dark: #166534;
  --color-warning: #f59e0b;
  --color-warning-light: #fef3c7;
  --color-warning-dark: #92400e;
  --color-error: #ef4444;
  --color-error-light: #fee2e2;
  --color-info: #3b82f6;
  --color-info-light: #dbeafe;
  /* Kept identical to the backoffice per DESIGN.md §17. \`--color-info\` on
     \`--color-info-light\` measures 3.01:1 and FAILS AA; this measures 7.15:1. */
  --color-info-dark: #1e40af;

  --color-recording: #dc2626;
  --color-avatar-bg: #0f172a;

  /* === Typography === */
  /* Open Sans — self-hosted via @fontsource/open-sans (GDPR-safe; no Google Fonts runtime call) */
  --font-sans: 'Open Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;

  /* === Spacing === */
  --spacing-section: 4rem;
  --spacing-panel: 1.5rem;
  --spacing-avatar-panel: 2rem;
  --spacing-nav: 4rem;
  --spacing-sidebar: 16rem;

  /* D12 — control sizing. 44px is WCAG 2.2 SC 2.5.5 (Enhanced, AAA); a
     deliberate step above the 24px AA floor the previous 32px already
     cleared. 36px keeps dense contexts (table filter rows, inline table
     actions) comfortably above the AA floor. Applied to both Nuxt apps in
     the same commit per §17. */
  --spacing-control: 2.75rem;
  --spacing-control-sm: 2.25rem;

  /* === Border radius === */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --radius-full: 9999px;

  /* === Shadows === */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
  --shadow-avatar: 0 25px 50px -12px rgb(0 0 0 / 0.5);"
`;
